// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

// ─── Freelancer ──────────────────────────────────────────────────────────────
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  cpf           String   @unique
  phone         String?
  avatarUrl     String?
  resumeUrl     String?
  isActive      Boolean  @default(true)
  isBlocked     Boolean  @default(false)
  loginAttempts Int      @default(0)
  blockedUntil  DateTime?

  refreshTokens UserRefreshToken[]
  techStack     UserTechnology[]

  favorites    Favorite[]
  messages     Message[]
  notifications Notification[]
  applications  Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ─── Empresa / Anunciante ─────────────────────────────────────────────────────
model Company {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  cnpj          String   @unique
  phone         String?
  avatarUrl     String?
  isActive      Boolean  @default(true)
  isBlocked     Boolean  @default(false)
  loginAttempts Int      @default(0)
  blockedUntil  DateTime?

  refreshTokens CompanyRefreshToken[]
  jobs          Job[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

// ─── Refresh Tokens ───────────────────────────────────────────────────────────

model UserRefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("user_refresh_tokens")
}

model CompanyRefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("company_refresh_tokens")
}

// ─── Tecnologia ( stacks)────────────────────────────────────────────────────────
model Technology {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  jobs      JobTechnology[]
  users     UserTechnology[]

  createdAt DateTime @default(now())

  @@map("technologies")
}

// ─── Vaga de Emprego ────────────────────────────────────────────────────────────
model Job {
  id           String   @id @default(uuid())
  title        String
  description  String
  requirements String
  deadline     DateTime
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  isFilled     Boolean  @default(false)

  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  technologies JobTechnology[]

  favorites    Favorite[]
  messages     Message[]
  applications Application[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([isActive, createdAt])
  @@index([expiresAt])
  @@map("jobs")
}

// ─── Relação N:N Vaga-Tecnologia ────────────────────────────────────────────────
model JobTechnology {
  jobId          String
  technologyId   String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technology     Technology   @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([jobId, technologyId])
  @@map("job_technologies")
}

// ─── Relação N:N Usuário-Tecnologia (Stack do Freelancer) ───────────────────────
model UserTechnology {
  userId       String
  technologyId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([userId, technologyId])
  @@map("user_technologies")
}

// ─── Favorito ────────────────────────────────────────────────────────────────
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@map("favorites")
}

// ─── Mensagem de Contato ──────────────────────────────────────────────────────────
enum MessageStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Message {
  id            String        @id @default(uuid())
  content       String
  status        MessageStatus @default(PENDING)

  jobId         String
  companyId    String
  candidateId  String

  job          Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate   User    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([candidateId])
  @@map("messages")
}

// ─── Notificação ────────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  type      String
  content   String
  data      Json?
  read      Boolean  @default(false)

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ─── Candidatura ────────────────────────────────────────────────────────────────
enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

model Application {
  id        String            @id @default(uuid())
  resumeUrl String
  coverLetter String?
  status    ApplicationStatus @default(PENDING)

  userId    String
  jobId     String

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([userId])
  @@map("applications")
}