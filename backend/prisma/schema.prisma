// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

// ─── Freelancer ──────────────────────────────────────────────────────────────
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  cpf           String   @unique
  phone         String?
  avatarUrl     String?
  resumeUrl     String?
  bio           String?
  isActive      Boolean  @default(true)
  isBlocked     Boolean  @default(false)
  loginAttempts Int      @default(0)
  blockedUntil  DateTime?

  refreshTokens UserRefreshToken[]
  techStack     UserTechnology[]

  experiences   UserExperience[]
  portfolio     UserPortfolioItem[]

  favorites    Favorite[]
  messages     Message[]
  notifications Notification[]
  applications  Application[]
  givenReviews  Review[] @relation("ReviewGivenByUser")
  receivedReviews Review[] @relation("ReviewReceivedByUser")
  passwordResetCodes UserPasswordResetCode[]
  subscription       UserSubscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ─── Empresa / Anunciante ─────────────────────────────────────────────────────
model Company {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  cnpj          String   @unique
  phone         String?
  avatarUrl     String?
  isActive      Boolean  @default(true)
  isBlocked     Boolean  @default(false)
  loginAttempts Int      @default(0)
  blockedUntil  DateTime?

  refreshTokens CompanyRefreshToken[]
  jobs          Job[]
  messages     Message[]
  notifications Notification[]
  givenReviews Review[] @relation("ReviewGivenByCompany")
  receivedReviews Review[] @relation("ReviewReceivedByCompany")
  passwordResetCodes CompanyPasswordResetCode[]
  subscription       CompanySubscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

// ─── Refresh Tokens ───────────────────────────────────────────────────────────

model UserRefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("user_refresh_tokens")
}

model UserPasswordResetCode {
  id         String   @id @default(uuid())
  userId     String
  codeHash   String
  attempts   Int      @default(0)
  verifiedAt DateTime?
  usedAt     DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("user_password_reset_codes")
}

model CompanyRefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("company_refresh_tokens")
}

model CompanyPasswordResetCode {
  id         String   @id @default(uuid())
  companyId  String
  codeHash   String
  attempts   Int      @default(0)
  verifiedAt DateTime?
  usedAt     DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("company_password_reset_codes")
}

// ─── Tecnologia ( stacks)────────────────────────────────────────────────────────
model Technology {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  jobs      JobTechnology[]
  users     UserTechnology[]

  createdAt DateTime @default(now())

  @@map("technologies")
}

enum SkillLevel {
  BASICO
  INTERMEDIARIO
  AVANCADO
  ESPECIALISTA
}

enum JobTechnologyType {
  REQUIRED
  DESIRABLE
}

enum JobStatus {
  OPEN
  PAUSED
  CLOSED
  CANCELLED
}

enum JobPaymentType {
  FIXED_RANGE
  HOURLY
}

// ─── Vaga de Emprego ────────────────────────────────────────────────────────────
model Job {
  id           String   @id @default(uuid())
  title        String
  description  String
  requirements String
  deadline     DateTime
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  isFilled     Boolean  @default(false)
  status       JobStatus @default(OPEN)
  paymentType  JobPaymentType?
  budgetMin    Decimal? @db.Decimal(12, 2)
  budgetMax    Decimal? @db.Decimal(12, 2)
  hourlyRate   Decimal? @db.Decimal(12, 2)
  currency     String   @default("BRL")

  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  technologies JobTechnology[]

  favorites    Favorite[]
  messages     Message[]
  applications Application[]
  reviews      Review[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([status, createdAt])
  @@index([isActive, createdAt])
  @@index([expiresAt])
  @@map("jobs")
}

// ─── Relação N:N Vaga-Tecnologia ────────────────────────────────────────────────
model JobTechnology {
  jobId          String
  technologyId   String
  type           JobTechnologyType @default(REQUIRED)
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technology     Technology   @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([jobId, technologyId])
  @@index([jobId, type])
  @@map("job_technologies")
}

// ─── Relação N:N Usuário-Tecnologia (Stack do Freelancer) ───────────────────────
model UserTechnology {
  userId       String
  technologyId String
  level        SkillLevel @default(BASICO)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([userId, technologyId])
  @@map("user_technologies")
}

// ─── Favorito ────────────────────────────────────────────────────────────────
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@map("favorites")
}

// ─── Mensagem de Contato ──────────────────────────────────────────────────────────
enum MessageStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Message {
  id            String        @id @default(uuid())
  content       String
  status        MessageStatus @default(PENDING)

  jobId         String
  companyId    String
  candidateId  String

  job          Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate   User    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([candidateId])
  @@map("messages")
}

// ─── Notificação ────────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  type      String
  content   String
  data      Json?
  read      Boolean  @default(false)

  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([companyId, read])
  @@map("notifications")
}

// ─── Candidatura ────────────────────────────────────────────────────────────────
enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ActorType {
  USER
  COMPANY
}

model Application {
  id        String            @id @default(uuid())
  resumeUrl String
  coverLetter String?
  status    ApplicationStatus @default(PENDING)
  companyCompletedAt DateTime?
  userCompletedAt    DateTime?

  userId    String
  jobId     String

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([userId])
  @@map("applications")
}

model Review {
  id            String   @id @default(uuid())
  applicationId String
  jobId         String
  reviewerType  ActorType
  reviewerUserId String?
  reviewerCompanyId String?
  reviewedType  ActorType
  reviewedUserId String?
  reviewedCompanyId String?
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  job           Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewerUser  User?       @relation("ReviewGivenByUser", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  reviewerCompany Company?  @relation("ReviewGivenByCompany", fields: [reviewerCompanyId], references: [id], onDelete: Cascade)
  reviewedUser  User?       @relation("ReviewReceivedByUser", fields: [reviewedUserId], references: [id], onDelete: Cascade)
  reviewedCompany Company?  @relation("ReviewReceivedByCompany", fields: [reviewedCompanyId], references: [id], onDelete: Cascade)

  @@index([reviewedType, reviewedUserId, reviewedCompanyId, createdAt])
  @@index([applicationId])
  @@index([jobId])
  @@unique([reviewerType, reviewerUserId, reviewerCompanyId, reviewedType, reviewedUserId, reviewedCompanyId, jobId])
  @@map("reviews")
}

// ─── Experiências Profissionais (Perfil) ───────────────────────────────────────
model UserExperience {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  roleTitle   String?
  startDate   DateTime
  endDate     DateTime?
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, startDate])
  @@map("user_experiences")
}

// ─── Portfólio em destaque (Perfil) ───────────────────────────────────────────
model UserPortfolioItem {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  url         String
  description String?
  imageUrl    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("user_portfolio_items")
}

// ─── Planos (soft — sem gateway de pagamento no MVP) ─────────────────────────

enum PlanAudience {
  USER
  COMPANY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

model Plan {
  id          String       @id @default(uuid())
  audience    PlanAudience
  code        String
  name        String
  description String
  priceLabel  String
  limits      Json
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)

  userSubscriptions    UserSubscription[]
  companySubscriptions CompanySubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([audience, code])
  @@map("plans")
}

model UserSubscription {
  id        String             @id @default(uuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@map("user_subscriptions")
}

model CompanySubscription {
  id        String             @id @default(uuid())
  companyId String             @unique
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@map("company_subscriptions")
}