# Connect to Supabase via connection pooling (runtime / Prisma Client)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations: Session pooler (5432). Se P1001 no host db.*, use esta URL.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

JWT_ACCESS_SECRET="change_me_min_32_chars_access_secret_here"
JWT_REFRESH_SECRET="change_me_min_32_chars_refresh_secret_here"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3333
NODE_ENV=development

# CORS — origens extras (vírgula). task-io-7d3.pages.dev e previews entram automaticamente.
FRONTEND_URL=http://localhost:5173

BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
BLOCK_DURATION_MINUTES=30

PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# SMTP (recuperação de senha e notificações de candidatura) — opcional em dev
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Supabase Storage (upload de avatar)
SUPABASE_URL=
# Recomendado em produção. Deixe em branco ou omita para usar SUPABASE_ANON_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_AVATAR_BUCKET=avatars
AVATAR_MAX_BYTES=2097152
